# Dependencies
**/node_modules/

# Next.js build output
**/.next/
**/out/
**/build/

# Environment / secrets -- never commit real credentials.
# .env.example files are intentionally NOT matched by these patterns.
**/.env
**/.env.local
**/.env.*.local
deployment/.secret-backups/

# Deployment secrets embedded directly in these files (not env-var
# references) -- a live signed Supabase service_role JWT in kong.yml,
# and Let's Encrypt's private key material in acme.json. Excluded rather
# than sanitized, to avoid shipping a template that silently drifts from
# what's actually deployed.
deployment/config/kong.yml
deployment/traefik/letsencrypt/

# E2E test run artifacts (regenerated, not source)
e2e/test-results/
e2e/playwright-report/

# Large binary archives -- not source, and exceed GitHub's 100MB
# per-file limit anyway. (greyin_b3.7z is 2.3 GB.)
/greyin_b*.7z

# Pitch-deck binaries -- iterative .pptx/.pdf revisions and the source
# Slidesgo templates. Large, not source code, and git can't diff binary
# formats meaningfully -- committing them bloats history permanently.
# Files stay on disk; just untracked.
docs/business-pitch/PitchDeck/
docs/templates/

# Database backups -- raw pg_dump output, never belongs in git regardless
# of repo visibility. These accumulate automatically (nightly rotation)
# and were previously committed by mistake; untracked going forward.
deployment/backups/*.sql.gz

# OS
.DS_Store
Thumbs.db

# LibreOffice lock files (left behind by headless soffice conversions)
.~lock.*#

# Logs
*.log
npm-debug.log*

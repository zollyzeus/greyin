# Greyin & GreyMatters Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================================
# DOMAINS (Single domain with subdomains)
# ============================================================
MAIN_DOMAIN=greyin.net
BLOG_DOMAIN=greymatters.greyin.net
COMMUNITY_DOMAIN=saltnpepper.greyin.net
FLEXPRO_DOMAIN=flexpro.greyin.net
STACKWORKS_DOMAIN=stackworks.greyin.net
LONGLIST_DOMAIN=longlist.greyin.net

# ============================================================
# TRAEFIK CONFIGURATION
# ============================================================
# Name of your existing Traefik network (default: traefik_proxy)
TRAEFIK_NETWORK=traefik_proxy

# ============================================================
# DATABASE PASSWORDS (Generate strong random passwords!)
# ============================================================
# Generate with: openssl rand -base64 32
ODOO_DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_123456789
DISCOURSE_DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD_987654321

# ============================================================
# ADMIN CREDENTIALS
# ============================================================
ADMIN_EMAIL=admin@greyin.net
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
# Example: Infy@121238

# Odoo workers (4 for 8GB RAM, 8 for 16GB RAM)
ODOO_WORKERS=4(Optional - configure after Odoo setup)
# ============================================================
# Generate with: openssl rand -hex 32
DISCOURSE_SSO_SECRET=CHANGE_THIS_SSO_SECRET_64_CHARS_HEX
ENABLE_SSO=false  # Set to true after configuring SSO in Odoo======
# DISCOURSE SSO SECRET (Generate with: openssl rand -hex 32)
# ============================================================
DISCOURSE_SSO_SECRET=CHANGE_THIS_SSO_SECRET_64_CHARS_HEX

# ============================================================
# SMTP CONFIGURATION
# ============================================================

# Hostinger (Recommended for greyin.net)
SMTP_ADDRESS=smtp.hostinger.com
SMTP_PORT=587
SMTP_USERNAME=admin@greyin.net
SMTP_PASSWORD=YOUR_EMAIL_PASSWORD

# Alternative: SendGrid Free Tier (100 emails/day)
# SMTP_ADDRESS=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=YOUR_SENDGRID_API_KEY

# Alternative: Postmark
# SMTP_ADDRESS=smtp.postmarkapp.com
# SMTP_PORT=587
# SMTP_USERNAME=YOUR_POSTMARK_API_KEY
# SMTP_PASSWORD=YOUR_POSTMARK_API_KEY

# Alternative: Mailgun
# SMTP_ADDRESS=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USERNAME=postmaster@your-domain.com
# SMTP_PASSWORD=YOUR_MAILGUN_PASSWORD

# ============================================================
# OPTIONAL: PLAUSIBLE ANALYTICS
# ============================================================
# PLAUSIBLE_DB_PASSWORD=CHANGE_THIS_PLAUSIBLE_PASSWORD
# PLAUSIBLE_SECRET=CHANGE_THIS_PLAUSIBLE_SECRET_64_CHARS

# ============================================================
# BACKUP CONFIGURATION
# ============================================================
# Backblaze B2 (Recommended - $0.005/GB/month)
# B2_APPLICATION_KEY_ID=your_key_id
# B2_APPLICATION_KEY=your_application_key
# B2_BUCKET_NAME=greyin-backups

# AWS S3 Alternative
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# S3_BUCKET_NAME=greyin-backups
# AWS_REGION=us-east-1

# ============================================================
# TIMEZONE
# ============================================================
TZ=America/New_York

# ============================================================
# PERFORMANCE TUNING
# ============================================================
ODOO_WORKERS=4
ODOO_MAX_CRON_THREADS=2
